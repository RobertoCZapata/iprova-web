# ===================================
# Variables de Entorno - iPROVA Website
# ===================================
#
# INSTRUCCIONES:
# 1. Copia este archivo como ".env.local"
# 2. Reemplaza los valores de ejemplo con los reales
# 3. NUNCA hagas commit de .env.local (ya está en .gitignore)
#

# ===================================
# Site Configuration
# ===================================
# URL pública del sitio (sin trailing slash)
NEXT_PUBLIC_SITE_URL=https://iprova.com.co

# ===================================
# Google Analytics 4
# ===================================
# Measurement ID de Google Analytics 4 (formato: G-XXXXXXXXXX)
# Obtén tu ID en: https://analytics.google.com/
#
# Pasos para obtener tu Measurement ID:
# 1. Ve a Google Analytics (analytics.google.com)
# 2. Crea una propiedad GA4 o usa una existente
# 3. Ve a Admin > Data Streams > Web
# 4. Copia el "Measurement ID" (comienza con G-)
#
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===================================
# Google Tag Manager (Opcional)
# ===================================
# Container ID de Google Tag Manager (formato: GTM-XXXXXXX)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ===================================
# Resend - Servicio de Email
# ===================================
# API Key de Resend para envío de emails del formulario de contacto
# Obtén tu API Key en: https://resend.com/api-keys
#
# Pasos para obtener tu API Key:
# 1. Regístrate en resend.com/signup
# 2. Ve a "API Keys" en el menú
# 3. Crea una nueva API Key con permisos de "Sending access"
# 4. Copia la key (comienza con re_)
#
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Email remitente (FROM)
# - Para pruebas: usa "onboarding@resend.dev" (dominio de prueba de Resend)
# - Para producción: verifica tu dominio y usa "contacto@iprova.com.co"
#
# Para verificar tu dominio iprova.com.co en Resend:
# 1. Ve a Domains en resend.com
# 2. Agrega tu dominio
# 3. Configura los registros DNS en GoDaddy (Resend te dará las instrucciones)
#
RESEND_FROM_EMAIL=onboarding@resend.dev

# Email destinatario (TO)
# Email donde llegarán las consultas del formulario de contacto
RESEND_TO_EMAIL=contacto@iprova.com.co
