# ===================================
# Variables de Entorno - iPROVA Website
# ===================================
#
# INSTRUCCIONES:
# 1. Copia este archivo como ".env.local"
# 2. Reemplaza los valores de ejemplo con los reales
# 3. NUNCA hagas commit de .env.local (ya está en .gitignore)
#

# ===================================
# Site Configuration
# ===================================
# URL pública del sitio (sin trailing slash)
NEXT_PUBLIC_SITE_URL=https://iprova.com.co

# ===================================
# Google Analytics 4
# ===================================
# Measurement ID de Google Analytics 4 (formato: G-XXXXXXXXXX)
# Obtén tu ID en: https://analytics.google.com/
#
# Pasos para obtener tu Measurement ID:
# 1. Ve a Google Analytics (analytics.google.com)
# 2. Crea una propiedad GA4 o usa una existente
# 3. Ve a Admin > Data Streams > Web
# 4. Copia el "Measurement ID" (comienza con G-)
#
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===================================
# Google Tag Manager (Opcional)
# ===================================
# Container ID de Google Tag Manager (formato: GTM-XXXXXXX)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
